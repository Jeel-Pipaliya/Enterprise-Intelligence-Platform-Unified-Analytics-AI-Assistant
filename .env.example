NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase default:
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Hosted Supabase example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_MAX_TOKENS=900
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Enterprise Intelligence Platform

# Backward-compatible alias used by older local setups:
LLM_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production-only values (configure these in the hosting provider, never commit
# a real value). CORS_ORIGINS must contain the complete frontend URL.
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend.vercel.app
# Frontend (Vercel; configure this separately in its dashboard):
VITE_API_URL=https://your-api.onrender.com
